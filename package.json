{
  "name": "@thaaaru/nova",
  "version": "0.1.0",
  "private": false,
  "description": "Nova governed AI-assisted Playwright test automation.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nova": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaaaru/nova.git"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/harden-licensing.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-keypair": "tsx scripts/generate-keypair.ts",
    "issue-license": "tsx scripts/issue-license.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "nova": "tsx src/cli.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chrome-launcher": "^1.2.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.12",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "javascript-obfuscator": "^5.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
