# Model configuration for Nova's LLM-backed steps (application
# identification and test-case suggestion). All optional: with none of
# these set, Nova records an honest zero-confidence identification and
# plans entirely from its deterministic rule pack. No command fails for
# want of a key. Never commit live credentials, session cookies, or
# test-account passwords.
#
# NOVA_LLM_PROVIDER: openai | deepseek | openai-compatible | ollama | self-hosted
# NOVA_LLM_PROVIDER=deepseek
# NOVA_LLM_MODEL=deepseek-chat
# NOVA_LLM_BASE_URL=            # required for openai-compatible/self-hosted
# NOVA_LLM_API_KEY=             # not needed for ollama/self-hosted endpoints that do not authenticate
# NOVA_LLM_TIMEOUT_MS=30000
# NOVA_LLM_MAX_RETRIES=2

# Still honoured on its own for existing installations; resolves to the
# deepseek provider.
# DEEPSEEK_API_KEY=

# Test accounts are resolved by the browser adapter, not sent to the model.
# TEST_ACCOUNT_STANDARD_EMAIL=
# TEST_ACCOUNT_STANDARD_PASSWORD=
